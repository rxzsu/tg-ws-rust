{
  "name": "tg-ws-proxy-gui",
  "private": true,
  "version": "1.3.0",
  "author": "nsvl",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vite build",
    "preview": "vite preview",
    "check": "node scripts/typecheck.cjs --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "fmt": "bun fmt src vite.config.ts index.html",
    "fmt:check": "bun fmt --check src vite.config.ts index.html",
    "tauri": "tauri"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.82",
    "@tauri-apps/plugin-autostart": "~2",
    "@tauri-apps/plugin-opener": "~2",
    "lucide-vue-next": "^1.0.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
